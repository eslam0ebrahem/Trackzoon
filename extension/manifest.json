{
    "manifest_version": 3,
    "name": "Trackzoon Distributed Scraper",
    "version": "1.0",
    "description": "Automatically syncs Amazon Egypt prices to Trackzoon.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "*://www.amazon.eg/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.amazon.eg/*/dp/*",
                "*://www.amazon.eg/dp/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Trackzoon Settings"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}