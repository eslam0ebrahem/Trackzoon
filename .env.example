# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trackzoon?retryWrites=true&w=majority

# Telegram Bot Configuration  
BOT_TOKEN=your_bot_token_from_botfather

# Application Port (for health checks)
PORT=3000

# Redis Configuration (Optional - for caching)
# Railway: Automatically set when you add Redis plugin
# External: redis://username:password@host:port
# REDIS_URL=redis://default:password@redis-host:6379

# Error Monitoring (Optional)
# Get your DSN from https://sentry.io
# SENTRY_DSN=your_sentry_dsn_here
