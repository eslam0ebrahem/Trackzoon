# Database Configuration
MONGODB_URI=mongodb://localhost:27017/trackzoon

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key_here # Generate using: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000 # Use your production URL on Vercel (e.g., https://your-app.vercel.app)

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional: Webhook URL for Telegram Bot (Required for Vercel deployment)
WEBHOOK_URL=https://your-app.vercel.app/api/bot/webhook
